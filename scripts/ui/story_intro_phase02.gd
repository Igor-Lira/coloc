extends "res://scripts/ui/story_intro.gd"

func _ready() -> void:
	lines = [
		"Jules est seul en train de cuisiner après sa longue journée de stage… en préparant le plat préféré de sa coloc : un bœuf bourguignon… même si sa coloc n'en a jamais goûté.",
		"Il entend le bruit d'intrus dans la maison, mais son casque ne lui permet pas d'anticiper le massacre. Il lâche un cri concis et élégant :\n« Nique ta mère, je dois jouer avec mon pote dans deux minutes et vingt-deux secondes ! »",
		"Il va affronter les plus grands de la planète… mais pas pour sauver l'humanité. Juste pour pouvoir jouer à temps.",
	]
	super._ready()
